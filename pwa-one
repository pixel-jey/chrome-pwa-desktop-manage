#!/bin/bash

# pwa-one
# Purpose: One-step creation of PWA with automatic icon retrieval and assignment.

# Check for required arguments
if [ "$#" -ne 3 ]; then
    echo "Usage: $0 <ID> <NAME> <FILE>"
    echo "Example: $0 iokcpacooodkojephihoonachammplkp Search search"
    exit 1
fi

ID=$1
NAME=$2
FILE=$3

# 1. Create the PWA desktop entry
echo "Step 1: Creating PWA entry..."
pwa create "$ID" "$NAME" "$FILE"

# 2. Fetch the icon
echo "Step 2: Fetching icon via pwa-icon..."
pwa-icon "$ID"

# 3. Apply the icon if 128.png was generated
if [ -f "128.png" ]; then
    echo "Step 3: Updating PWA icon..."
    pwa icon 128.png "$ID"
    echo "Success: PWA [$NAME] created and icon updated."
else
    echo "Warning: 128.png not found. Icon update skipped."
    exit 1
fi

